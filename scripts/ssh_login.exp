#!/usr/bin/expect -f
set timeout 120
set password $env(SRF_PASSWORD)
log_user 0
set prompt_re {>}
spawn ssh -tt \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o RequestTTY=yes \
  CEFLS_User@10.138.186.198
expect {
  -re {(?i)are you sure you want to continue connecting} { send "yes\r"; exp_continue }
  -re {(?i)password:}                                   { send "$password\r"; exp_continue }
  -re {(?i)permission denied}                           { puts "FAILURE: Invalid credentials"; exit 1 }
  -re {(?i)connection timed out|no route to host|connection refused} { puts "FAILURE: SSH network/connectivity issue"; exit 1 }
  -re $prompt_re {}
  eof     { puts "FAILURE: SSH session closed before prompt"; exit 1 }
  timeout { puts "FAILURE: Timed out waiting for SSH login"; exit 1 }
}
log_user 1
puts "SUCCESS: Logged in to Windows host"
log_user 0
send "whoami\r"
expect {
  -re $prompt_re {}
  eof     { puts "FAILURE: SSH session closed after whoami"; exit 1 }
  timeout { puts "FAILURE: whoami timed out"; exit 1 }
}
send "cd C:\\Users\\pkummara\\scripts\r"
expect {
  -re $prompt_re {}
  eof     { puts "FAILURE: SSH session closed after cd"; exit 1 }
  timeout { puts "FAILURE: cd timed out"; exit 1 }
}
send "dir\r"
expect {
  -re $prompt_re {}
  eof     { puts "FAILURE: SSH session closed after dir"; exit 1 }
  timeout { puts "FAILURE: dir timed out"; exit 1 }
}
set timeout 300
send "C:\\Python310\\python.exe -u .\\deploy_reboot_wrapper.py\r"
expect {
  -re $prompt_re {}
  eof     { puts "FAILURE: SSH session closed during Python execution"; exit 1 }
  timeout { puts "FAILURE: Python script did not complete in time"; exit 1 }
}
send "exit\r"
expect eof
